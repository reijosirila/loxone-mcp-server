# Loxone connection settings
# LOXONE_HOST accepts an IP, a hostname or a full base URL (e.g. https://miniserver.example:443 for Gen. 2 remote access)
LOXONE_HOST=192.168.1.100
LOXONE_USERNAME=admin
LOXONE_PASSWORD=your-password

# Optional when LOXONE_HOST has no scheme/port: port (default 80 for http, 443 for https) and protocol (http|https)
# LOXONE_PORT=80
# LOXONE_PROTOCOL=http

# How long startup waits for the Miniserver to become ready before failing (milliseconds, default 30000)
# LOXONE_CONNECT_TIMEOUT_MS=30000

# Or connect over the internet using Loxone DNS
# This will auto-discover Loxone external URL and port
# LOXONE_SERIAL_NUMBER=

# MCP Transport configuration
# Options: stdio (default), http
MCP_TRANSPORT=stdio

# HTTP server port (only used when MCP_TRANSPORT=http)
# Default: 3000
PORT=3000
# Alternative: MCP_PORT=3000

# API Key for HTTP authentication (only used when MCP_TRANSPORT=http)
# If not set, the HTTP server will be publicly accessible
# Supports both Bearer token and X-API-Key header
# MCP_API_KEY=your-secure-api-key-here

# Log level (0=ERROR, 1=WARN, 2=INFO, 3=DEBUG)
# Default: 1 for stdio, 2 for http
LOG_LEVEL=2